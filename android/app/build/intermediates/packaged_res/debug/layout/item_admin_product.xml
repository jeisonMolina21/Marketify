<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivAdminProdImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_catalog"
            android:contentDescription="Product thumbnail" />

        <TextView
            android:id="@+id/tvAdminProdName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/slate_900"
            android:textSize="@dimen/text_medium"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvAdminProdPrice"
            app:layout_constraintStart_toEndOf="@id/ivAdminProdImage"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Reloj Chronos Luxury Edition" />

        <TextView
            android:id="@+id/tvAdminProdSKU"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/slate_400"
            android:textSize="9sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/ivAdminProdImage"
            app:layout_constraintTop_toBottomOf="@id/tvAdminProdName"
            tools:text="SKU: MKF-1024" />

        <!-- Stock and Status Badges -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toEndOf="@id/ivAdminProdImage"
            app:layout_constraintTop_toBottomOf="@id/tvAdminProdSKU">

            <TextView
                android:id="@+id/tvAdminProdStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/slate_500"
                android:textSize="@dimen/text_small"
                tools:text="45 unidades" />

            <TextView
                android:id="@+id/tvAdminProdStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_rounded_card"
                android:backgroundTint="#EFF6FF"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/blue_600"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:text="Activo" />

        </LinearLayout>

        <!-- Price -->
        <TextView
            android:id="@+id/tvAdminProdPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/slate_900"
            android:textSize="@dimen/text_medium"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnAdminDelete"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="$1.250.000" />

        <!-- Delete item button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminDelete"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_trash"
            app:iconSize="20dp"
            app:iconTint="@color/red_500"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="Delete Item" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
