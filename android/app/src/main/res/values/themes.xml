<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Marketify" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/marketify_green</item>
        <item name="colorPrimaryVariant">@color/marketify_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/marketify_orange</item>
        <item name="colorSecondaryVariant">@color/marketify_orange</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Background and Surface colors -->
        <item name="android:windowBackground">@color/slate_50</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/slate_900</item>
        
        <!-- TextInputLayout Theme customizations -->
        <item name="textInputStyle">@style/Widget.Marketify.TextInputLayout</item>
    </style>

    <!-- Custom TextInputLayout for premium round text input borders -->
    <style name="Widget.Marketify.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/marketify_green</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="hintTextColor">@color/marketify_green</item>
        <item name="android:textColorHint">@color/slate_400</item>
    </style>

    <!-- Custom styles for buttons -->
    <style name="Widget.Marketify.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/marketify_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Marketify.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/slate_200</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/slate_900</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:fontFamily">sans-serif-bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/slate_100</item>
    </style>
</resources>
