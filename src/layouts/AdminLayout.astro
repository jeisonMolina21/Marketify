---
import '../styles/globals.css';
import { LayoutDashboard, Package, ShoppingCart, Users, FileText, Settings, LogOut, Bell, Search } from 'lucide-react';

interface Props {
  title: string;
}

const { title } = Astro.props;

const menuItems = [
  { label: 'Dashboard', href: '/admin', icon: LayoutDashboard },
  { label: 'Productos', href: '/admin/products', icon: Package },
  { label: 'Órdenes', href: '/admin/orders', icon: ShoppingCart },
  { label: 'Clientes', href: '/admin/customers', icon: Users },
  { label: 'Facturación', href: '/admin/billing', icon: FileText },
  { label: 'Configuración', href: '/admin/settings', icon: Settings },
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title} | Admin Marketify</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    h1, h2, h3, h4, h5, h6 { font-family: 'Outfit', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 min-h-screen flex">
  <!-- Sidebar -->
  <aside class="w-72 bg-white border-r border-slate-200 hidden lg:flex flex-col h-screen sticky top-0">
    <div class="p-8 border-b border-slate-100 flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-emerald-600 flex items-center justify-center text-white">
        <Package class="w-6 h-6" />
      </div>
      <div>
        <h2 class="text-xl font-black text-slate-900 leading-none">Marketify</h2>
        <p class="text-[10px] uppercase font-black text-emerald-600 tracking-widest mt-1">Admin Panel</p>
      </div>
    </div>

    <nav class="flex-1 p-6 space-y-2 overflow-y-auto custom-scrollbar">
      {menuItems.map((item) => (
        <a 
          href={item.href} 
          class={`flex items-center gap-3 px-5 py-4 rounded-2xl font-bold text-sm transition-all ${
            Astro.url.pathname === item.href 
              ? 'bg-emerald-600 text-white shadow-xl shadow-emerald-500/20' 
              : 'text-slate-500 hover:bg-slate-50 hover:text-slate-900'
          }`}
        >
          <item.icon class="w-5 h-5" />
          {item.label}
        </a>
      ))}
    </nav>

    <div class="p-6 border-t border-slate-100">
      <button class="w-full flex items-center gap-3 px-5 py-4 rounded-2xl font-bold text-sm text-red-500 hover:bg-red-50 transition-all">
        <LogOut class="w-5 h-5" />
        Cerrar Sesión
      </button>
    </div>
  </aside>

  <!-- Main Content -->
  <div class="flex-1 flex flex-col min-h-screen">
    <!-- Top Nav -->
    <header class="h-20 bg-white border-b border-slate-200 px-8 flex items-center justify-between sticky top-0 z-50">
      <div class="flex items-center gap-4 flex-1">
        <div class="relative max-w-md w-full hidden md:block">
          <Search class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
          <input type="text" placeholder="Buscar órdenes, productos..." class="w-full bg-slate-50 border-none rounded-xl py-3 pl-12 pr-4 text-sm font-medium focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all" />
        </div>
      </div>

      <div class="flex items-center gap-6">
        <button class="relative p-2.5 text-slate-400 hover:text-slate-900 transition-colors">
          <Bell class="w-5 h-5" />
          <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
        </button>
        <div class="h-8 w-px bg-slate-200"></div>
        <div class="flex items-center gap-3">
          <div class="text-right hidden sm:block">
            <p class="text-sm font-black text-slate-900">Admin Marketify</p>
            <p class="text-[10px] font-bold text-emerald-600 uppercase tracking-widest">Super Admin</p>
          </div>
          <div class="w-10 h-10 rounded-xl bg-slate-200 overflow-hidden border-2 border-white shadow-sm">
            <img src="https://ui-avatars.com/api/?name=Admin&background=008a3e&color=fff" alt="Profile" />
          </div>
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main class="p-8 flex-1">
      <slot />
    </main>
  </div>
</body>
</html>
