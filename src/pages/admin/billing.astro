---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { FileText, Download, CheckCircle2, AlertCircle, Clock, ExternalLink, Search } from 'lucide-react';

const invoices = [
  { id: 'FE-2024-001', customer: 'Inversiones ABC S.A.S', nit: '901.234.567-8', date: '2024-04-30', status: 'Aceptado DIAN', total: '$4.520.000' },
  { id: 'FE-2024-002', customer: 'Juan Pérez', nit: '1.010.123.456', date: '2024-04-30', status: 'Procesando', total: '$850.000' },
  { id: 'FE-2024-003', customer: 'Tecnologías del Sur', nit: '800.111.222-3', date: '2024-04-29', status: 'Aceptado DIAN', total: '$12.800.000' },
  { id: 'FE-2024-004', customer: 'María García', nit: '52.123.456', date: '2024-04-29', status: 'Error DIAN', total: '$320.000' },
];
---

<AdminLayout title="Facturación Electrónica DIAN">
  <div class="space-y-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <h1 class="text-4xl font-black text-slate-900 tracking-tight mb-2">Facturación Electrónica</h1>
        <p class="text-slate-500 font-medium">Control de documentos XML/PDF y estados de emisión DIAN.</p>
      </div>
      <div class="flex items-center gap-3">
        <div class="px-4 py-2 bg-emerald-50 text-emerald-600 rounded-xl text-xs font-black uppercase tracking-widest border border-emerald-100 flex items-center gap-2">
           <CheckCircle2 class="w-4 h-4" /> Proveedor API Conectado
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Total Mes</p>
        <h3 class="text-3xl font-black text-slate-900">$245.8M</h3>
        <p class="text-[10px] text-emerald-600 font-bold mt-1">124 facturas emitidas</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Pendientes DIAN</p>
        <h3 class="text-3xl font-black text-orange-500">2</h3>
        <p class="text-[10px] text-orange-400 font-bold mt-1">Sincronización en curso</p>
      </div>
      <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <p class="text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Rechazadas</p>
        <h3 class="text-3xl font-black text-red-500">1</h3>
        <p class="text-[10px] text-red-400 font-bold mt-1">Requiere atención inmediata</p>
      </div>
    </div>

    <!-- Invoices Table -->
    <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-sm overflow-hidden">
      <div class="p-8 border-b border-slate-50 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <h3 class="text-xl font-bold text-slate-900">Historial de Facturas</h3>
        <div class="relative w-full md:w-72">
          <Search class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
          <input type="text" placeholder="Buscar por CUFE o NIT..." class="w-full bg-slate-50 border-none rounded-xl py-3 pl-12 pr-4 text-xs font-medium focus:ring-2 focus:ring-emerald-500/20 outline-none" />
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Factura</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Cliente / NIT</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Fecha</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Total</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Estado DIAN</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Archivos</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            {invoices.map((inv) => (
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="px-8 py-5">
                  <div class="flex items-center gap-3">
                    <FileText class="w-4 h-4 text-slate-400" />
                    <span class="text-sm font-bold text-slate-900">{inv.id}</span>
                  </div>
                </td>
                <td class="px-8 py-5">
                  <p class="text-sm font-bold text-slate-900 leading-none">{inv.customer}</p>
                  <p class="text-[10px] font-medium text-slate-400 mt-1">{inv.nit}</p>
                </td>
                <td class="px-8 py-5 text-xs text-slate-500 font-medium">{inv.date}</td>
                <td class="px-8 py-5 text-sm font-black text-slate-900">{inv.total}</td>
                <td class="px-8 py-5">
                  <div class={`inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ${
                    inv.status === 'Aceptado DIAN' ? 'bg-emerald-50 text-emerald-600' :
                    inv.status === 'Procesando' ? 'bg-orange-50 text-orange-600' :
                    'bg-red-50 text-red-600'
                  }`}>
                    {inv.status === 'Aceptado DIAN' ? <CheckCircle2 class="w-3 h-3" /> :
                     inv.status === 'Procesando' ? <Clock class="w-3 h-3" /> :
                     <AlertCircle class="w-3 h-3" />}
                    {inv.status}
                  </div>
                </td>
                <td class="px-8 py-5 text-right">
                  <div class="flex justify-end gap-2">
                    <button class="p-2 rounded-lg bg-slate-50 text-slate-600 hover:bg-emerald-50 hover:text-emerald-600 transition-all flex items-center gap-2 text-[10px] font-black uppercase">
                      <Download class="w-4 h-4" /> PDF
                    </button>
                    <button class="p-2 rounded-lg bg-slate-50 text-slate-600 hover:bg-blue-50 hover:text-blue-600 transition-all flex items-center gap-2 text-[10px] font-black uppercase">
                      <ExternalLink class="w-4 h-4" /> XML
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
