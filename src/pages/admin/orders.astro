---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ShoppingBag, Search, Filter, Eye, Truck, Package, Clock, CheckCircle2 } from 'lucide-react';

const orders = [
  { id: '#ORD-9824', customer: 'Juan Pérez', email: 'juan@email.com', date: '2024-04-30 14:45', status: 'Pagado', items: 3, total: '$1.250.000', shipping: 'Express' },
  { id: '#ORD-9823', customer: 'María García', email: 'maria@email.com', date: '2024-04-30 13:20', status: 'Enviado', items: 1, total: '$450.000', shipping: 'Estándar' },
  { id: '#ORD-9822', customer: 'Luis Rodríguez', email: 'luis@email.com', date: '2024-04-30 11:15', status: 'Pendiente', items: 2, total: '$850.000', shipping: 'Recogida' },
  { id: '#ORD-9821', customer: 'Ana Martínez', email: 'ana@email.com', date: '2024-04-29', status: 'Pagado', items: 5, total: '$3.200.000', shipping: 'Express' },
];
---

<AdminLayout title="Gestión de Órdenes">
  <div class="space-y-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <h1 class="text-4xl font-black text-slate-900 tracking-tight mb-2">Órdenes</h1>
        <p class="text-slate-500 font-medium">Monitorea y gestiona los pedidos de tus clientes en tiempo real.</p>
      </div>
    </div>

    <!-- Tabs -->
    <div class="flex items-center gap-2 border-b border-slate-200">
      {['Todas', 'Pendientes', 'Pagadas', 'Enviadas', 'Canceladas'].map((tab, i) => (
        <button class={`px-6 py-4 text-sm font-bold transition-all border-b-2 ${
          i === 0 ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-slate-400 hover:text-slate-600'
        }`}>
          {tab}
        </button>
      ))}
    </div>

    <!-- Table -->
    <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">ID Orden</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Cliente</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Fecha</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Productos</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Total</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Estado</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            {orders.map((order) => (
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="px-8 py-5 text-sm font-bold text-slate-900">{order.id}</td>
                <td class="px-8 py-5">
                  <p class="text-sm font-bold text-slate-900 leading-none">{order.customer}</p>
                  <p class="text-[10px] font-medium text-slate-400 mt-1">{order.email}</p>
                </td>
                <td class="px-8 py-5 text-xs text-slate-500 font-medium">{order.date}</td>
                <td class="px-8 py-5 text-sm font-medium text-slate-600">{order.items} items</td>
                <td class="px-8 py-5 text-sm font-black text-slate-900">{order.total}</td>
                <td class="px-8 py-5">
                  <div class={`inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ${
                    order.status === 'Pagado' ? 'bg-emerald-50 text-emerald-600' :
                    order.status === 'Enviado' ? 'bg-blue-50 text-blue-600' :
                    'bg-orange-50 text-orange-600'
                  }`}>
                    {order.status === 'Pagado' ? <CheckCircle2 class="w-3 h-3" /> :
                     order.status === 'Enviado' ? <Truck class="w-3 h-3" /> :
                     <Clock class="w-3 h-3" />}
                    {order.status}
                  </div>
                </td>
                <td class="px-8 py-5 text-right">
                  <button class="p-2 rounded-lg text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 transition-all">
                    <Eye class="w-5 h-5" />
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
