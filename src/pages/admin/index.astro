---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { TrendingUp, ShoppingBag, Users, DollarSign, ArrowUpRight, ArrowDownRight, Clock, FileCheck } from 'lucide-react';

const stats = [
  { label: 'Ventas Totales', value: '$45.2M', growth: '+12.5%', isUp: true, icon: DollarSign, color: 'text-emerald-600', bg: 'bg-emerald-50' },
  { label: 'Nuevas Órdenes', value: '1,284', growth: '+5.2%', isUp: true, icon: ShoppingBag, color: 'text-blue-600', bg: 'bg-blue-50' },
  { label: 'Nuevos Clientes', value: '452', growth: '-2.4%', isUp: false, icon: Users, color: 'text-purple-600', bg: 'bg-purple-50' },
  { label: 'Facturas DIAN', value: '1,120', growth: '+8.1%', isUp: true, icon: FileCheck, color: 'text-orange-600', bg: 'bg-orange-50' },
];

const recentOrders = [
  { id: '#ORD-9824', customer: 'Juan Pérez', status: 'Pagado', amount: '$1.250.000', date: 'Hoy, 2:45 PM' },
  { id: '#ORD-9823', customer: 'María García', status: 'Enviado', amount: '$450.000', date: 'Hoy, 1:20 PM' },
  { id: '#ORD-9822', customer: 'Luis Rodríguez', status: 'Pendiente', amount: '$850.000', date: 'Hoy, 11:15 AM' },
  { id: '#ORD-9821', customer: 'Ana Martínez', status: 'Pagado', amount: '$320.000', date: 'Ayer' },
];
---

<AdminLayout title="Dashboard Overview">
  <div class="space-y-10">
    <!-- Welcome -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <h1 class="text-4xl font-black text-slate-900 tracking-tight mb-2">Panel de Control</h1>
        <p class="text-slate-500 font-medium">Bienvenido de nuevo, Admin. Aquí está el resumen de hoy.</p>
      </div>
      <div class="flex items-center gap-3">
        <button class="bg-white border border-slate-200 px-5 py-3 rounded-xl text-sm font-bold text-slate-900 flex items-center gap-2 hover:bg-slate-50 transition-all">
          <Clock class="w-4 h-4" />
          Últimos 30 días
        </button>
        <button class="bg-emerald-600 text-white px-5 py-3 rounded-xl text-sm font-bold flex items-center gap-2 shadow-lg shadow-emerald-500/20 hover:bg-emerald-700 transition-all">
          Generar Reporte
        </button>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {stats.map((stat) => (
        <div class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm hover:shadow-xl hover:shadow-slate-200/50 transition-all group">
          <div class="flex items-start justify-between mb-6">
            <div class={`w-14 h-14 rounded-2xl ${stat.bg} ${stat.color} flex items-center justify-center`}>
              <stat.icon class="w-7 h-7" />
            </div>
            <div class={`flex items-center gap-1 text-xs font-black px-2 py-1 rounded-lg ${stat.isUp ? 'bg-emerald-50 text-emerald-600' : 'bg-red-50 text-red-600'}`}>
              {stat.isUp ? <ArrowUpRight class="w-3 h-3" /> : <ArrowDownRight class="w-3 h-3" />}
              {stat.growth}
            </div>
          </div>
          <div>
            <p class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-1">{stat.label}</p>
            <h3 class="text-3xl font-black text-slate-900 tracking-tighter group-hover:text-emerald-700 transition-colors">{stat.value}</h3>
          </div>
        </div>
      ))}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Recent Orders -->
      <div class="lg:col-span-8 bg-white rounded-[2.5rem] border border-slate-100 shadow-sm overflow-hidden">
        <div class="p-8 border-b border-slate-50 flex items-center justify-between">
          <h3 class="text-xl font-bold text-slate-900">Órdenes Recientes</h3>
          <a href="/admin/orders" class="text-sm font-bold text-emerald-600 hover:underline">Ver todas</a>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">ID Orden</th>
                <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Cliente</th>
                <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Estado</th>
                <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Monto</th>
                <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Fecha</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
              {recentOrders.map((order) => (
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="px-8 py-5 text-sm font-bold text-slate-900">{order.id}</td>
                  <td class="px-8 py-5 text-sm font-medium text-slate-600">{order.customer}</td>
                  <td class="px-8 py-5">
                    <span class={`px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ${
                      order.status === 'Pagado' ? 'bg-emerald-50 text-emerald-600' :
                      order.status === 'Enviado' ? 'bg-blue-50 text-blue-600' :
                      'bg-orange-50 text-orange-600'
                    }`}>
                      {order.status}
                    </span>
                  </td>
                  <td class="px-8 py-5 text-sm font-black text-slate-900">{order.amount}</td>
                  <td class="px-8 py-5 text-xs text-slate-400 font-bold">{order.date}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Quick Actions / Top Products -->
      <div class="lg:col-span-4 space-y-8">
        <div class="bg-slate-900 rounded-[2.5rem] p-8 text-white">
          <h3 class="text-xl font-bold mb-6">Acciones Rápidas</h3>
          <div class="space-y-4">
            <button class="w-full bg-white/10 hover:bg-white/20 px-6 py-4 rounded-2xl text-left font-bold transition-all flex items-center justify-between">
              Agregar Producto
              <ArrowUpRight class="w-4 h-4 text-emerald-400" />
            </button>
            <button class="w-full bg-white/10 hover:bg-white/20 px-6 py-4 rounded-2xl text-left font-bold transition-all flex items-center justify-between">
              Configurar Descuentos
              <TrendingUp class="w-4 h-4 text-blue-400" />
            </button>
            <button class="w-full bg-white/10 hover:bg-white/20 px-6 py-4 rounded-2xl text-left font-bold transition-all flex items-center justify-between">
              Soporte al Cliente
              <Users class="w-4 h-4 text-purple-400" />
            </button>
          </div>
        </div>

        <div class="bg-white border border-slate-100 rounded-[2.5rem] p-8 shadow-sm">
          <h3 class="text-xl font-bold text-slate-900 mb-6">Ventas por Canal</h3>
          <div class="space-y-6">
            <div>
              <div class="flex justify-between text-xs font-black text-slate-400 uppercase tracking-widest mb-2">
                <span>Tienda Online</span>
                <span class="text-slate-900">75%</span>
              </div>
              <div class="h-2 w-full bg-slate-100 rounded-full overflow-hidden">
                <div class="h-full bg-emerald-500 rounded-full" style="width: 75%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-xs font-black text-slate-400 uppercase tracking-widest mb-2">
                <span>Marketplace</span>
                <span class="text-slate-900">15%</span>
              </div>
              <div class="h-2 w-full bg-slate-100 rounded-full overflow-hidden">
                <div class="h-full bg-blue-500 rounded-full" style="width: 15%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-xs font-black text-slate-400 uppercase tracking-widest mb-2">
                <span>WhatsApp</span>
                <span class="text-slate-900">10%</span>
              </div>
              <div class="h-2 w-full bg-slate-100 rounded-full overflow-hidden">
                <div class="h-full bg-orange-500 rounded-full" style="width: 10%"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
