---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Plus, Search, Filter, MoreVertical, Edit2, Trash2, ExternalLink } from 'lucide-react';

const products = [
  { id: '1', name: 'Reloj Chronos Luxury Edition', price: 1250000, stock: 45, status: 'Activo', category: 'Accesorios', image: '/images/watch.png' },
  { id: '2', name: 'Audífonos Sonic Max Wireless', price: 850000, stock: 12, status: 'Activo', category: 'Tecnología', image: '/images/headphones.png' },
  { id: '3', name: 'Gafas de Sol Polaris Black', price: 450000, stock: 0, status: 'Sin Stock', category: 'Moda', image: 'https://images.unsplash.com/photo-1511499767390-a7335958beba?q=80&w=2000&auto=format&fit=crop' },
  { id: '4', name: 'Mochila Urbana Tech Pro', price: 320000, stock: 89, status: 'Activo', category: 'Estilo de Vida', image: 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?q=80&w=2000&auto=format&fit=crop' },
];
---

<AdminLayout title="Gestión de Productos">
  <div class="space-y-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <h1 class="text-4xl font-black text-slate-900 tracking-tight mb-2">Inventario</h1>
        <p class="text-slate-500 font-medium">Gestiona tus productos, stock y visibilidad en la tienda.</p>
      </div>
      <button class="bg-emerald-600 text-white px-8 py-4 rounded-2xl font-bold flex items-center gap-3 shadow-xl shadow-emerald-500/20 hover:bg-emerald-700 transition-all">
        <Plus class="w-5 h-5" />
        Nuevo Producto
      </button>
    </div>

    <!-- Filters & Search -->
    <div class="flex flex-col md:flex-row gap-4">
      <div class="relative flex-1">
        <Search class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
        <input type="text" placeholder="Buscar por nombre, SKU..." class="w-full bg-white border border-slate-200 rounded-xl py-4 pl-12 pr-4 text-sm font-medium focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none transition-all" />
      </div>
      <button class="bg-white border border-slate-200 px-6 py-4 rounded-xl text-sm font-bold text-slate-700 flex items-center gap-2 hover:bg-slate-50 transition-all">
        <Filter class="w-4 h-4" />
        Filtros
      </button>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Producto</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Categoría</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Precio</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Stock</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">Estado</th>
              <th class="px-8 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            {products.map((product) => (
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="px-8 py-5">
                  <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-slate-100 overflow-hidden shrink-0">
                      <img src={product.image} alt={product.name} class="w-full h-full object-cover" />
                    </div>
                    <div>
                      <p class="text-sm font-bold text-slate-900">{product.name}</p>
                      <p class="text-[10px] font-medium text-slate-400">SKU: MKF-{product.id}024</p>
                    </div>
                  </div>
                </td>
                <td class="px-8 py-5">
                  <span class="text-xs font-bold text-slate-600 bg-slate-100 px-3 py-1 rounded-lg">{product.category}</span>
                </td>
                <td class="px-8 py-5 text-sm font-black text-slate-900">
                  ${product.price.toLocaleString('es-CO')}
                </td>
                <td class="px-8 py-5 text-sm font-medium text-slate-600">
                  {product.stock} unidades
                </td>
                <td class="px-8 py-5">
                  <span class={`px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ${
                    product.status === 'Activo' ? 'bg-emerald-50 text-emerald-600' : 'bg-red-50 text-red-600'
                  }`}>
                    {product.status}
                  </span>
                </td>
                <td class="px-8 py-5 text-right">
                  <div class="flex justify-end gap-2">
                    <button class="p-2 rounded-lg text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 transition-all">
                      <Edit2 class="w-4 h-4" />
                    </button>
                    <button class="p-2 rounded-lg text-slate-400 hover:text-blue-600 hover:bg-blue-50 transition-all">
                      <ExternalLink class="w-4 h-4" />
                    </button>
                    <button class="p-2 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-all">
                      <Trash2 class="w-4 h-4" />
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      
      <!-- Pagination -->
      <div class="p-8 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
        <p class="text-xs font-bold text-slate-400">Mostrando 1 a 4 de 24 productos</p>
        <div class="flex gap-2">
          <button class="px-4 py-2 bg-white border border-slate-200 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-50 transition-all">Anterior</button>
          <button class="px-4 py-2 bg-emerald-600 text-white rounded-lg text-xs font-bold">1</button>
          <button class="px-4 py-2 bg-white border border-slate-200 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-50 transition-all">2</button>
          <button class="px-4 py-2 bg-white border border-slate-200 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-50 transition-all">Siguiente</button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
