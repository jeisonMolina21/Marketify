---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard';
import { ArrowRight, ShoppingBag, Zap, ShieldCheck, Truck } from 'lucide-react';

const featuredProducts = [
  {
    id: '1',
    name: 'Reloj Chronos Luxury Edition',
    price: 1250000,
    image: '/images/watch.png',
    category: 'Accesorios',
    rating: 5,
    reviews: 124
  },
  {
    id: '2',
    name: 'Audífonos Sonic Max Wireless',
    price: 850000,
    image: '/images/headphones.png',
    category: 'Tecnología',
    rating: 4,
    reviews: 89
  },
  {
    id: '3',
    name: 'Gafas de Sol Polaris Black',
    price: 450000,
    image: 'https://images.unsplash.com/photo-1511499767390-a7335958beba?q=80&w=2000&auto=format&fit=crop',
    category: 'Moda',
    rating: 5,
    reviews: 45
  },
  {
    id: '4',
    name: 'Mochila Urbana Tech Pro',
    price: 320000,
    image: 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?q=80&w=2000&auto=format&fit=crop',
    category: 'Estilo de Vida',
    rating: 4,
    reviews: 67
  }
];

const categories = [
  { name: 'Tecnología', icon: '💻', count: '120+ productos', color: 'bg-blue-500' },
  { name: 'Moda', icon: '👕', count: '450+ productos', color: 'bg-emerald-500' },
  { name: 'Hogar', icon: '🏠', count: '230+ productos', color: 'bg-orange-500' },
  { name: 'Deportes', icon: '⚽', count: '180+ productos', color: 'bg-purple-500' },
];
---

<MainLayout title="E-commerce Premium en Colombia">
  <Navbar client:load slot="header" />

  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center pt-20 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="/images/hero.png" class="w-full h-full object-cover opacity-20" alt="Hero background" />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-50/0 via-slate-50/80 to-slate-50"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-100 text-emerald-700 text-xs font-black uppercase tracking-widest mb-8 animate-in fade-in slide-in-from-bottom-4 duration-1000">
          <Zap class="w-4 h-4" />
          Nuevas Colecciones 2026
        </div>
        
        <h1 class="text-6xl md:text-8xl font-black text-slate-900 tracking-tighter leading-[0.9] mb-8 animate-in fade-in slide-in-from-bottom-8 duration-1000 delay-100">
          Descubre el <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-emerald-900">Futuro del Shopping</span>
        </h1>
        
        <p class="text-xl text-slate-500 font-medium mb-10 max-w-xl animate-in fade-in slide-in-from-bottom-12 duration-1000 delay-200">
          Experiencia premium, envíos rápidos en toda Colombia y facturación electrónica instantánea. Tu estilo, a un click de distancia.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 animate-in fade-in slide-in-from-bottom-16 duration-1000 delay-300">
          <a href="/catalog" class="btn-primary-marketify px-10 py-5 text-lg shadow-2xl shadow-emerald-500/20 group">
            Explorar Catálogo
            <ArrowRight class="w-5 h-5 transition-transform group-hover:translate-x-1" />
          </a>
          <button class="btn-secondary-marketify px-10 py-5 text-lg backdrop-blur-md bg-white/50">
            Ver Ofertas
          </button>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-8 mt-16 pt-16 border-t border-slate-200 animate-in fade-in duration-1000 delay-500">
          <div>
            <p class="text-3xl font-black text-slate-900">50k+</p>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Clientes Felices</p>
          </div>
          <div>
            <p class="text-3xl font-black text-slate-900">12k+</p>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Productos</p>
          </div>
          <div>
            <p class="text-3xl font-black text-slate-900">24h</p>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Envío Express</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Grid -->
  <section id="categories" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-16">
        <div>
          <h2 class="text-4xl font-black text-slate-900 tracking-tight mb-4">Comprar por Categoría</h2>
          <p class="text-slate-500 font-medium">Explora nuestra selección curada de productos de alta gama.</p>
        </div>
        <a href="/catalog" class="text-emerald-600 font-bold flex items-center gap-2 group">
          Ver todas <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {categories.map((cat) => (
          <div class="group relative h-64 rounded-[2rem] overflow-hidden cursor-pointer">
            <div class={`absolute inset-0 ${cat.color} opacity-10 group-hover:opacity-20 transition-all duration-500`}></div>
            <div class="absolute inset-0 p-8 flex flex-col justify-between">
              <div class="text-4xl">{cat.icon}</div>
              <div>
                <h3 class="text-2xl font-black text-slate-900 mb-1">{cat.name}</h3>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">{cat.count}</p>
              </div>
            </div>
            <div class="absolute bottom-6 right-6 w-12 h-12 rounded-full bg-white flex items-center justify-center opacity-0 group-hover:opacity-100 translate-y-4 group-hover:translate-y-0 transition-all duration-500 shadow-xl">
              <ArrowRight class="w-6 h-6 text-slate-900" />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-4xl font-black text-slate-900 tracking-tight mb-4">Productos Destacados</h2>
        <p class="text-slate-500 font-medium">Lo más top de esta semana. Elegido por expertos, amado por nuestra comunidad.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {featuredProducts.map((product) => (
          <ProductCard client:visible product={product} />
        ))}
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="py-20 bg-white border-y border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="flex items-center gap-6">
          <div class="w-16 h-16 rounded-2xl bg-emerald-50 flex items-center justify-center text-emerald-600">
            <Truck class="w-8 h-8" />
          </div>
          <div>
            <h4 class="font-bold text-slate-900">Envíos Rápidos</h4>
            <p class="text-sm text-slate-500">Gratis por compras superiores a $200.000</p>
          </div>
        </div>
        <div class="flex items-center gap-6">
          <div class="w-16 h-16 rounded-2xl bg-orange-50 flex items-center justify-center text-orange-600">
            <ShieldCheck class="w-8 h-8" />
          </div>
          <div>
            <h4 class="font-bold text-slate-900">Compra Segura</h4>
            <p class="text-sm text-slate-500">Pasarela de pagos encriptada 256-bit</p>
          </div>
        </div>
        <div class="flex items-center gap-6">
          <div class="w-16 h-16 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600">
            <ShoppingBag class="w-8 h-8" />
          </div>
          <div>
            <h4 class="font-bold text-slate-900">Garantía Total</h4>
            <p class="text-sm text-slate-500">30 días para devoluciones sin costo</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 px-4">
    <div class="max-w-7xl mx-auto rounded-[3rem] overflow-hidden luxury-gradient relative">
      <div class="absolute top-0 right-0 w-96 h-96 bg-white/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-emerald-500/20 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
      
      <div class="relative z-10 px-8 py-20 md:px-20 text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-12">
        <div class="max-w-2xl">
          <h2 class="text-4xl md:text-5xl font-black text-white tracking-tight mb-6">
            Únete a la nueva era del <br class="hidden md:block" /> comercio electrónico.
          </h2>
          <p class="text-emerald-50/80 text-lg font-medium">
            Regístrate hoy y obtén un 10% de descuento en tu primera compra premium.
          </p>
        </div>
        <button class="bg-white text-emerald-900 font-bold px-10 py-5 rounded-2xl text-lg hover:bg-emerald-50 transition-all shadow-2xl shadow-emerald-950/20 whitespace-nowrap">
          Empezar Ahora
        </button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</MainLayout>
